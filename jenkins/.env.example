# Copia este archivo a .env y completa los valores.  NO se comitea (.gitignore).
#   cp jenkins/.env.example jenkins/.env

# --- Admin de Jenkins (lo crea JCasC en el primer arranque) ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=pass

# --- Puerto de la UI en el host ---
# OJO: 8080 tambien lo usa el mapeo del cluster k3d de este repo (k3d/k3d-config.yaml).
# Si vas a correr ambos a la vez, cambia uno.
JENKINS_HTTP_PORT=8090

# --- Docker Hub  (credential id: dockerhub-team-credentials) ---
DOCKERHUB_USERNAME=jfuquene
DOCKERHUB_TOKEN=

# --- GitHub  (credential id: github-credentials) ---
# Token con permiso de push:  classic -> scope "repo"  |  fine-grained -> Contents: Read and write
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- Origen del pipeline (de donde Jenkins lee el Jenkinsfile) ---
GIT_REPO_URL=https://github.com/Topejuanse/microservico-actividad-3-diplomado-devops.git
GIT_BRANCH=main
